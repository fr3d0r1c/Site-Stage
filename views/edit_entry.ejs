<%- include('partials/header', { pageTitle: pageTitle }) %>

<h1><%= t('page_titles.edit_entry') %></h1>

<div id="local-draft-banner" class="draft-banner" role="status" hidden></div>
<form action="/entree/<%= article.id %>/edit" method="POST" id="entry-form" data-draft-key="edit-<%= article.id %>" data-article-status="<%= article.status %>">
    <div class="title-layout">
        <div class="title-field">
            <label for="title_fr"><%= t('forms.title_fr') %> :</label><br>
            <input type="text" id="title_fr" name="title_fr" value="<%= article.title_fr %>" required>
        </div>
        <div class="title-field">
            <label for="title_en"><%= t('forms.title_en') %> :</label><br>
            <input type="text" id="title_en" name="title_en" value="<%= article.title_en %>" placeholder="Rempli automatiquement, modifiable">
            <small id="title-en-status" class="field-status" aria-live="polite"></small>
        </div>
    </div>
    <hr>

    <div class="dual-editor-layout">
        <div style="flex: 1;">
            <label for="summary_fr"><%= t('forms.summary_fr') %> :</label><br>
            <textarea id="summary_fr" name="summary_fr" rows="3" placeholder="Un court texte d'accroche..."><%= (typeof article !== 'undefined' && article.summary_fr) ? article.summary_fr : '' %></textarea>
        </div>
        <div style="flex: 1;">
            <label for="summary_en"><%= t('forms.summary_en') %> :</label><br>
            <textarea id="summary_en" name="summary_en" rows="3" placeholder="A short summary..."><%= (typeof article !== 'undefined' && article.summary_en) ? article.summary_en : '' %></textarea>
        </div>
    </div>
    <hr>

    <div class="editor-container-main">

        <div class="editor-and-preview-fr">
            <div class="editor-pane">
                <label for="content-editor-fr"><%= t('forms.content_fr') %> :</label><br>
                <textarea id="content-editor-fr" name="content_fr" rows="20"><%= article.content_fr %></textarea>
            </div>
            <div class="preview-pane">
                <label><%= t('general.preview') %> (FR) :</label><br>
                <div id="preview_fr" class="article-content"></div>
            </div>
        </div>

        <div class="preview-pane-en-standalone">
            <label><%= t('general.preview') %> (EN) (Auto):</label><br>
            <div id="preview_en" class="article-content"></div>
        </div>

    </div> <hr>

    <details class="en-correction" id="en-correction">
        <summary><i class="fas fa-language"></i> Version anglaise : relire et corriger à la main</summary>
        <p class="field-hint">
            L'anglais est traduit automatiquement quand vous modifiez le français. Dès que vous corrigez un champ anglais ici,
            il n'est plus écrasé. Le bouton ci-dessous refait toute la traduction depuis le français.
        </p>
        <label for="content_en">Contenu anglais (Markdown) :</label>
        <textarea id="content_en" name="content_en" rows="14" aria-label="Contenu anglais (Markdown)"><%= article.content_en %></textarea>
        <button type="button" id="retranslate-btn" class="btn btn-secondary"><i class="fas fa-sync-alt"></i> Retraduire tout depuis le français</button>
        <span id="content-en-status" class="field-status" aria-live="polite"></span>
    </details>
    <hr>

    <input type="file" id="image-upload-input" style="display: none;" accept="image/*">

    <div class="form-group">
        <label><i class="fas fa-map-marker-alt"></i> Localisation (Latitude / Longitude) :</label>
        <div style="display: flex; gap: 10px;">
            <input type="number" step="any" name="lat" placeholder="Lat (ex: 48.8566)" 
                value="<%= locals.article ? article.lat : '' %>">
            <input type="number" step="any" name="lng" placeholder="Lng (ex: 2.3522)" 
                value="<%= locals.article ? article.lng : '' %>">
        </div>
        <small style="color: var(--c-text-light);">Astuce : Faites un clic droit sur Google Maps -> "Plus d'infos" pour avoir ces chiffres.</small>
    </div>

    <div class="cover-field">
        <label for="cover_image_url"><%= t('forms.cover_image_url') %> :</label><br>
        <div class="cover-field-row">
            <input type="text" id="cover_image_url" name="cover_image_url" placeholder="Collez l'adresse d'une image, ou envoyez un fichier" value="<%= article.cover_image_url || '' %>">
            <button type="button" id="cover-upload-btn" class="btn btn-secondary"><i class="fas fa-upload"></i> Envoyer une image</button>
            <button type="button" id="cover-remove-btn" class="btn btn-secondary" hidden><i class="fas fa-times"></i> Retirer</button>
        </div>
        <input type="file" id="cover-upload-input" accept="image/jpeg,image/png,image/webp,image/gif" hidden>
        <img id="cover-preview" class="cover-preview" alt="Aperçu de l'image de couverture" hidden>
        <small><%= t('forms.cover_image_hint') %></small>
    </div>

    <div>
        <div class="tags-label-container">
            <label>Tags :</label>
            <button type="button" id="open-tag-modal-btn" class="add-tag-btn" title="Ajouter un tag">+</button>
        </div>
        <div class="tags-checkbox-list">
            <% if (allTags && allTags.length > 0) { %>
                <% allTags.forEach(tag => { %>
                    <div class="tag-checkbox-item">
                        <input
                            type="checkbox"
                            name="tags"
                            value="<%= tag.id %>"
                            id="tag-<%= tag.id %>"
                            <% if (typeof articleTagIds !== 'undefined' && articleTagIds.has(tag.id)) { %> checked <% } %>
                        >
                        <label for="tag-<%= tag.id %>"><%= tag.name %></label>
                    </div>
                <% }); %>
            <% } else { %>
                <p><i><%= t('admin_page.no_tags') %> Cliquez sur <button type="button" id="open-tag-modal-btn" class="add-tag-btn" title="<%= t('admin_page.add_new_tag_title') %>">+</button> Pour en créer. </i></p>
            <% } %>
        </div>
    </div>

    <div style="display: flex; gap: 10px; align-items: center;">
        <button type="submit" name="action" value="published" id="submit-button" class="btn">
            <i class="fas fa-paper-plane"></i> <%= t('forms.update_entry') %>
        </button>

        <button type="submit" name="action" value="draft" class="btn" style="background-color: #f39c12; border-color: #f39c12; color: white;">
            <i class="fas fa-save"></i> Sauvegarder Brouillon
        </button>

        <a href="/journal"
            class="btn btn-secondary"
            data-confirm="<%= t('general.cancel_confirm', 'Êtes-vous sûr de vouloir annuler ?') %>">
            <%= t('general.cancel') %>
        </a>
    </div>
</form>

<div id="tag-modal-overlay" class="modal-overlay">
    <div id="tag-modal-content" class="modal-content static-page">
        <button id="close-tag-modal-btn" class="modal-close-btn">&times;</button>
        <h2><%= t('admin_page.add_new_tag_title') %></h2>
        
        <form id="new-tag-form">
            <div class="form-group">
                <label for="new_tag_name_fr"><%= t('admin_page.tag_name_fr') %> :</label>
                <input type="text" id="new_tag_name_fr" name="name_fr" required>
            </div>
            <div class="form-group">
                <label for="new_tag_name_en"><%= t('admin_page.tag_name_en') %> :</label>
                <input type="text" id="new_tag_name_en" name="name_en">
                <small>Laissez vide pour auto-traduction (si DeepL est configuré).</small>
            </div>
            <div>
                <button type="submit" id="create-tag-submit-btn"><%= t('admin_page.add_tag_button') %></button>
            </div>
            <div id="tag-modal-error" style="color: var(--c-danger); display: none; margin-top: 1rem; font-weight: bold;"></div>
        </form>
    </div>
</div>
<%# Versions et empreintes (SRI) fixées : le navigateur refuse tout fichier modifié sur le CDN %>
<script src="https://cdn.jsdelivr.net/npm/marked@4.3.0/marked.min.js" integrity="sha384-QsSpx6a0USazT7nK7w8qXDgpSAPhFsb2XtpoLFQ5+X2yFN6hvCKnwEzN8M5FWaJb" crossorigin="anonymous"></script>
<script src="https://unpkg.com/easymde@2.18.0/dist/easymde.min.js" integrity="sha384-KtB38COewxfrhJxoN2d+olxJAeT08LF8cVZ6DQ8Poqu89zIptqO6zAXoIxpGNWYE" crossorigin="anonymous"></script>

<script src="/js/auto-translate-preview.js"></script> 
<script src="/js/init-easymde.js"></script>          

<script src="/js/uploader.js"></script>
<script src="/js/modal-tag-handler.js"></script>
<script src="/js/form-validation.js"></script>
<script src="/js/entry-editor-extras.js"></script>

<%- include('partials/footer') %>


<%- include('partials/footer') %>
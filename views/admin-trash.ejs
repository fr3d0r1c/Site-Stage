<%- include('partials/header', { pageTitle: pageTitle }) %>

<div class="static-page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
        <h1 style="margin: 0; border: none;"><i class="fas fa-trash-restore"></i> Corbeille</h1>
        <span style="background: var(--c-surface); padding: 5px 15px; border-radius: 50px; border: 1px solid var(--c-border); font-weight: bold;">
            <%= articles.length %> article<%= articles.length > 1 ? 's' : '' %>
        </span>
    </div>

    <p class="field-hint">
        Les articles supprimés restent ici <strong><%= retentionDays %> jours</strong>, puis sont effacés définitivement
        (avec leurs commentaires et leurs likes). Ils ne sont plus visibles sur le site.
    </p>

    <% if (articles.length > 0) { %>
        <div class="table-wrapper">
            <table class="tags-table" style="width: 100%;">
                <thead>
                    <tr>
                        <th style="width: 45%">Article</th>
                        <th style="width: 20%">Supprimé le</th>
                        <th style="width: 15%">Reste</th>
                        <th style="width: 20%; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% articles.forEach(article => { %>
                        <tr>
                            <td data-label="Article" style="vertical-align: top;">
                                <strong><%= article.title_fr %></strong>
                                <% if (article.status === 'draft') { %>
                                    <span class="badge-guest" style="font-size: 0.6rem; margin-left: 5px;">BROUILLON</span>
                                <% } %>
                            </td>
                            <td data-label="Supprimé le" style="vertical-align: top;">
                                <%= new Date(article.deleted_at.replace(' ', 'T') + 'Z').toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                            </td>
                            <td data-label="Reste" style="vertical-align: top;">
                                <%= article.days_left %> jour<%= article.days_left > 1 ? 's' : '' %>
                            </td>
                            <td data-label="Actions" style="vertical-align: top; text-align: right; white-space: nowrap;">
                                <form action="/admin/trash/restore/<%= article.id %>" method="POST" style="display: inline-block;">
                                    <button type="submit" class="btn btn-secondary" title="Restaurer cet article">
                                        <i class="fas fa-undo"></i> Restaurer
                                    </button>
                                </form>
                                <form action="/admin/trash/purge/<%= article.id %>" method="POST"
                                      data-confirm="Supprimer définitivement « <%= article.title_fr %> » ? Cette action est irréversible."
                                      style="display: inline-block;">
                                    <button type="submit" class="btn-icon-danger" title="Supprimer définitivement">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <form action="/admin/trash/empty" method="POST"
              data-confirm="Vider la corbeille ? Les <%= articles.length %> article(s) seront supprimés définitivement."
              style="margin-top: 1.5rem;">
            <button type="submit" class="btn btn-secondary"><i class="fas fa-fire"></i> Vider la corbeille</button>
        </form>
    <% } else { %>
        <div style="text-align: center; padding: 4rem 2rem; color: var(--c-text-light); border: 2px dashed var(--c-border); border-radius: 12px;">
            <i class="far fa-trash-alt fa-3x" style="margin-bottom: 1rem; opacity: 0.5;"></i>
            <p style="font-size: 1.2rem;">La corbeille est vide.</p>
        </div>
    <% } %>

    <div style="margin-top: 2rem;">
        <a href="/journal" class="btn-text">&larr; Retour au journal</a>
    </div>
</div>

<%- include('partials/footer') %>

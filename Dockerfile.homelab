FROM node:22-alpine

# Outils de compilation (sqlite3, bcrypt) + Chromium pour Puppeteer
RUN apk add --no-cache python3 make g++ chromium nss freetype harfbuzz ttf-freefont
ENV PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app
COPY package*.json ./
RUN npm install --omit=dev --ignore-scripts && npm rebuild sqlite3 bcrypt

COPY . .
ENV NODE_ENV=production PORT=3000
EXPOSE 3000
CMD ["node", "server.js"]